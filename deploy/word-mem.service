[Unit]
Description=Word Memorize
After=network.target

[Service]
Type=simple
User=iridet
WorkingDirectory=/opt/word-mem
ExecStart=/usr/local/bin/node --disable-warning=ExperimentalWarning server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=27190
Environment=DB_FILE=/opt/word-mem/data/app.db
Environment=APP_ORIGIN=https://117.72.112.65:27191
Environment=COOKIE_SECURE=1
Environment=TRUST_PROXY=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/word-mem/data
UMask=0077

[Install]
WantedBy=multi-user.target
